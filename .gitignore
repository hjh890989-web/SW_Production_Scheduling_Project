# ==========================================================
# SW_Production_Scheduling_Project (.gitignore)
# Sprint 0 진입 전 사전 설치 — Next.js + Prisma + Auth.js + Docker 스택
# ==========================================================

# ----- Node.js / Next.js -----
node_modules/
.next/
out/
build/
dist/
.turbo/
.swc/
*.tsbuildinfo
next-env.d.ts

# ----- Package managers -----
.npm/
.yarn/
.pnpm-store/
.pnp.*
package-lock.json.bak

# ----- Test & coverage -----
coverage/
*.lcov
.nyc_output/
playwright-report/
test-results/
.vitest/

# ----- Environment & secrets -----
.env
.env.*
!.env.example
!.env.*.example
!.env.template

# ----- Prisma -----
prisma/*.db
prisma/*.db-journal
prisma/dev.db*
prisma/migrations/dev.db*

# ----- Logs -----
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ----- IDE / Editor -----
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
.idea/
*.swp
*.swo
*~
*.code-workspace

# ----- OS junk -----
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
~$*

# ----- Office temp files (Raw Materials/ 작업 시 자동 생성) -----
~$*.xlsx
~$*.xls
~$*.docx
~$*.doc
~$*.pptx

# ----- Docker / Infrastructure -----
infrastructure/nginx/ssl/*.crt
infrastructure/nginx/ssl/*.key
infrastructure/nginx/ssl/*.pem
!infrastructure/nginx/ssl/.gitkeep
infrastructure/data/
infrastructure/volumes/
infrastructure/backup/output/

# ----- Python (OR-Tools 마이크로서비스, Phase 2) -----
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.python-version

# ----- 임시 / 백업 -----
*.bak
*.tmp
*.temp
.cache/
tmp/
temp/

# ----- 보안 스캔 결과 -----
.gitleaks-report.json
trivy-report.*

# ----- 실제 사원 데이터 (실데이터 — 사내망 전용, git/외부 export 금지: CLAUDE §5) -----
*결재선*.xlsx
data/standard_imformation/

