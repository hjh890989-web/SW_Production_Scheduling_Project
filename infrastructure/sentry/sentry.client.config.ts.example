// T11.5 Sentry 클라이언트 설정 템플릿 — 적용 시 프로젝트 루트에 sentry.client.config.ts 로 복사.
// 사전: npm i @sentry/nextjs (신규 의존성, 별도 PR)
import * as Sentry from '@sentry/nextjs';

Sentry.init({
  dsn: process.env.NEXT_PUBLIC_SENTRY_DSN, // 사내 self-hosted DSN
  tracesSampleRate: 0.1,
  replaysSessionSampleRate: 0,
  environment: process.env.NODE_ENV,
});
