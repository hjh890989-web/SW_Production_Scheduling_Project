{
  "uid": "evs-http",
  "title": "EVS - HTTP",
  "schemaVersion": 39,
  "version": 1,
  "tags": ["evs"],
  "panels": [
    { "id": 1, "type": "timeseries", "title": "5xx Rate", "datasource": "Prometheus",
      "targets": [{ "expr": "rate(http_requests_total{status=~\"5..\"}[5m])" }], "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 } },
    { "id": 2, "type": "timeseries", "title": "p95 Latency", "datasource": "Prometheus",
      "targets": [{ "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket[5m]))" }], "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 } }
  ]
}
