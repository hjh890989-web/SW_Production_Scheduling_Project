generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ── 마스터 데이터 (Sprint 2) ──
// CORE-1: SQLite는 Prisma enum 미지원 → enum류는 String + 앱 레벨(TS union·Zod) 검증.

model Item {
  id             String   @id @default(cuid())
  productCode    String   @unique // 생산 품번
  customerCode   String? // 고객사 품번
  hwasungCode    String? // ERP(화성) 코드
  material       String   @default("silicone")
  // 압출 제약
  extrusionGroup Int? // E열 1-8
  headPin        String? // 22*8 등
  cutLength      Float? // 재단 길이(mm)
  extrusionSpeed Float? // 압출 속도
  extruderFord   Boolean  @default(false)
  extruderNew    Boolean  @default(false)
  // 성형 제약
  lpMoldsPerAngle Int? // 저압 앵글당 몰드 수
  icMoldsPerAngle Int? // IC 앵글당 몰드 수
  lpPosTop        Boolean @default(false) // 상단 위치 가능 여부
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  aliases        ItemAlias[]
  orders         Order[]
  moldingSchedules MoldingSchedule[]
  extrusionSchedules ExtrusionSchedule[]
  productionResults ProductionResult[]
  inventory       Inventory?
  deliveryResults DeliveryResult[]

  @@index([extrusionGroup])
}

model ItemAlias {
  id         String @id @default(cuid())
  itemId     String
  alias      String @unique
  normalized String // 정규화 키(normalizeProductCode 결과)
  item       Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([normalized])
  @@index([itemId])
}

model Equipment {
  id        String   @id @default(cuid())
  code      String   @unique // LP_1, IC_1, FORD, NEW ...
  name      String
  type      String // MOLDING_LP / MOLDING_IC / EXTRUSION (CORE-1)
  capacity  Json? // { slots: [...] } 또는 { lines: [...] }
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  moldingSchedules MoldingSchedule[]
  extrusionSchedules ExtrusionSchedule[]

  @@index([type])
}

model ExtrusionSchedule {
  id             String   @id @default(cuid())
  weekStart      DateTime
  date           DateTime
  shift          String // DAY_FIRST / DAY_SECOND / NIGHT_FIRST / NIGHT_SECOND
  extruderId     String
  itemId         String
  orderId        String?
  quantity       Int
  extrusionGroup Int?
  headPin        String?
  status         String   @default("AUTO") // AUTO / MANUAL / CONFIRMED (CORE-1 String)
  ruleViolation  Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  item           Item      @relation(fields: [itemId], references: [id])
  extruder       Equipment @relation(fields: [extruderId], references: [id])

  @@index([weekStart, extruderId])
  @@index([date, shift])
  @@index([itemId])
}

model MoldingSchedule {
  id            String   @id @default(cuid())
  weekStart     DateTime // 주간 시작(월) — 주차 단위 조회
  date          DateTime
  daynight      String // DAY / NIGHT
  equipmentId   String
  slotPosition  String
  itemId        String
  orderId       String?
  rotations     Int
  status        String   @default("AUTO") // AUTO / MANUAL / CONFIRMED (CORE-1 String)
  ruleViolation Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  item          Item      @relation(fields: [itemId], references: [id])
  equipment     Equipment @relation(fields: [equipmentId], references: [id])

  @@index([weekStart, equipmentId])
  @@index([date, daynight])
  @@index([itemId])
}

model OperationParam {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String // 모든 value는 String, 사용 시 parseFloat (AC T2.3-F1)
  category  String?
  label     String?
  updatedAt DateTime @updatedAt
}

model CalendarDay {
  date      DateTime @id // 일자 PK (UTC 자정)
  type      String   @default("NORMAL") // NORMAL/HOLIDAY/PM/TEMP_OFF (CORE-1)
  isWorkday Boolean  @default(true)
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── 수주 통합 (Sprint 3) ──
// CORE-1: enum류(orderType/sourceType/confidence/status)는 String + 앱 레벨(TS union) 검증.

model Order {
  id            String   @id @default(cuid())
  itemId        String
  rawProductCode String // 원본 엑셀 품번(정규화 전)
  deliveryDate  DateTime
  quantity      Int
  orderType     String // OEM / KD
  sourceType    String // weekly_plan / kd / monthly_forecast
  confidence    String // CONFIRMED / FORECAST / MIXED
  status        String   @default("ACTIVE") // ACTIVE / SUPERSEDED / CHANGED / CANCELLED
  uploadBatchId String?
  reason        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  item          Item     @relation(fields: [itemId], references: [id])

  @@index([itemId, deliveryDate])
  @@index([sourceType, status])
  @@index([uploadBatchId])
}

model ExcelMappingRule {
  id            String   @id @default(cuid())
  sourceType    String   @unique // weekly_plan / kd / monthly_forecast
  sheetName     String?
  headerRow     Int
  dataStartRow  Int
  columnMapping Json // { productCode: 8, material: 0, ... }
  updatedAt     DateTime @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  type      String // UNMATCHED_ITEM / ORDER_CHANGED / ...
  message   String
  payload   Json?
  targetUserId String?
  read      Boolean  @default(false)
  cancelled Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([targetUserId, read])
  @@index([type, createdAt])
}

model KsfDailySnapshot {
  date            DateTime @id // 일자(UTC 자정)
  ksf1Punctuality Float? // 납기율 (ProductionResult 기반, Sprint 6+)
  ksf5Unification Float? // 수주 일원화율
  ksf6Adoption    Float? // 수동보정 채택률 (J-MR-2, Sprint 5+)
  createdAt       DateTime @default(now())
}

// ── MES 연동 (Sprint 9) ──
// CORE-1: process(MOLDING/EXTRUSION)는 String + 앱 레벨(TS union·Zod) 검증.

model ProductionResult {
  id          String   @id @default(cuid())
  externalId  String   @unique // MES 고유 ID — 중복 수신 멱등성(T9.2)
  itemId      String
  equipmentCode String? // 설비 코드(매칭 실패 허용 → 문자열 보관)
  process     String // MOLDING / EXTRUSION
  quantity    Int
  producedAt  DateTime
  createdAt   DateTime @default(now())
  item        Item     @relation(fields: [itemId], references: [id])

  @@index([itemId, producedAt])
  @@index([process, producedAt])
}

model MesRetryQueue {
  id            String   @id @default(cuid())
  instructionId String
  payload       Json // MesInstructionPayload 직렬화
  attempts      Int      @default(0)
  maxAttempts   Int      @default(5)
  status        String   @default("PENDING") // PENDING / SENT / FAILED (CORE-1)
  lastError     String?
  nextRetryAt   DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status, nextRetryAt])
}

model Inventory {
  itemId    String   @id // 품번당 1행
  quantity  Int      @default(0) // 음수 금지(앱 레벨 가드, AC T9.3-F1)
  updatedAt DateTime @updatedAt
  item      Item     @relation(fields: [itemId], references: [id])
}

model DeliveryResult {
  id          String   @id @default(cuid())
  externalId  String?  @unique // 납품 실적 멱등 키(있을 때)
  itemId      String
  quantity    Int
  deliveredAt DateTime
  createdAt   DateTime @default(now())
  item        Item     @relation(fields: [itemId], references: [id])

  @@index([itemId, deliveredAt])
}

model User {
  id            String   @id @default(cuid())
  // 로그인 식별자는 사번/아이디(username) — 사내 공장 사용자 UX (CORE-4). email은 보조 연락처.
  username      String   @unique
  email         String?  @unique
  passwordHash  String
  name          String?
  // 6 Role: ADMIN / PRODUCTION_MANAGER / MOLDING_LEADER / EXTRUSION_LEADER / SALES_PURCHASE / EXECUTIVE (CORE-1)
  role          String   @default("MOLDING_LEADER")
  failedLogins  Int      @default(0)
  lockedUntil   DateTime?
  lastLoginAt   DateTime?
  passwordChangedAt DateTime?
  mustChangePassword Boolean @default(false)
  sessionVersion Int     @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model AuditLog {
  id           String   @id @default(cuid())
  userId       String?
  userRole     String?
  action       String
  targetTable  String?
  targetKey    String?
  beforeValue  String?
  afterValue   String?
  reason       String?
  ipAddress    String?
  sessionId    String?
  userAgent    String?
  timestamp    DateTime @default(now())

  @@index([userId, timestamp])
  @@index([targetTable, targetKey])
}
