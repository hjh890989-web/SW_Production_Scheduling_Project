# =========================================================
# EVS (Extrusion & Vulcanization Scheduling) — Environment Variables Template
# 실제 값은 .env.local (개발) 또는 .env.prod (운영)에 채우세요. 이 파일만 git 추적됩니다.
# =========================================================

# ----- Database -----
# 개발: SQLite 파일 기반
DATABASE_URL="file:./prisma/dev.db"
# 운영(PostgreSQL 16): postgresql://user:pass@host:5432/evs

# ----- Auth.js v5 -----
# 32+ 자 랜덤 시크릿 (openssl rand -base64 32)
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# ----- App -----
APP_BASE_URL="http://localhost:3000"
NODE_ENV="development"

# ----- External Integrations (사내망 전용 — Sprint 9/10) -----
# 영림원 ERP (Sprint 10 진입 전 TBD-2 확정 필요)
# ERP_BASE_URL=""
# ERP_API_KEY=""

# 자체 MES (Sprint 9 진입 전 TBD-3 확정 필요)
# MES_BASE_URL=""
# MES_API_KEY=""

# ----- Observability (운영 전용) -----
# LOKI_URL=""
# SLACK_WEBHOOK_URL=""

# ----- MinIO (객체 저장소, 운영 전용) -----
# MINIO_ENDPOINT=""
# MINIO_ACCESS_KEY=""
# MINIO_SECRET_KEY=""
