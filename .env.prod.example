# T11.7 운영 환경변수 템플릿 — `.env.prod`로 복사 후 사내 값 채움. 비밀값은 secrets 관리 권장.
# 주의: 실값 커밋 금지(.gitignore에 .env.prod 포함 확인).

# ── 앱/DB ──
DATABASE_URL="postgresql://evs:CHANGE_ME@postgres:5432/evs?schema=public"
AUTH_SECRET="CHANGE_ME_openssl_rand_base64_32"
NODE_ENV="production"

# ── PostgreSQL ──
POSTGRES_PASSWORD="CHANGE_ME"

# ── MinIO(객체 저장소) ──
MINIO_ROOT_USER="evs"
MINIO_ROOT_PASSWORD="CHANGE_ME"

# ── Grafana ──
GRAFANA_PASSWORD="CHANGE_ME"

# ── 알림(백업·KSF·Sentry 공용) ──
SLACK_WEBHOOK=""

# ── 백업(scripts/backup.sh) ──
NAS_DIR="/mnt/nas/evs-backup"
RETAIN_DAYS="365"

# ── 외부 연동(Sprint 9/10) — 미가동 시 Mock ──
MES_CLIENT="mock"
MES_API_KEY=""
ERP_CLIENT="mock"
ERP_API_KEY=""

# ── Phase 2(operations-phase2.md) — 도입 시 ──
